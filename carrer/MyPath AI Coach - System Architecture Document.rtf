// MARK: - Field Validation Tool\
class FieldValidationTool: AITool \{\
    let name = "validate_field"\
    let description = "Validates field values against rules"\
    \
    var parametersSchema: [String: Any] \{\
        return [\
            "type": "object",\
            "properties": [\
                "field": [\
                    "type": "string",\
                    "description": "The field name to validate"\
                ],\
                "value": [\
                    "type": "object",\
                    "description": "The value to validate"\
                ]\
            ],\
            "required": ["field", "value"]\
        ]\
    \}\
    \
    func execute(with parameters: [String: Any]) async throws -> Any \{\
        guard let field = parameters["field"] as? String,\
              let value = parameters["value"] else \{\
            throw ToolError.missingParameter("field or value")\
        \}\
        \
        // Validation rules based on field\
        var isValid = true\
        var validationMessage = "Valid"\
        \
        switch field \{\
        case "email":\
            if let email = value as? String \{\
                let emailRegex = "[A-Z0-9a-z._%+-]+@[A-Za-z0-9.-]+\\\\.[A-Za-z]\{2,64\}"\
                let emailPredicate = NSPredicate(format: "SELF MATCHES %@", emailRegex)\
                isValid = emailPredicate.evaluate(with: email)\
                validationMessage = isValid ? "Valid email format" : "Invalid email format"\
            \} else \{\
                isValid = false\
                validationMessage = "Email must be a string"\
            \}\
            \
        case "name":\
            if let name = value as? String \{\
                isValid = !name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty\
                validationMessage = isValid ? "Valid name" : "Name cannot be empty"\
            \} else \{\
                isValid = false\
                validationMessage = "Name must be a string"\
            \}\
            \
        case "age":\
            if let age = value as? Int \{\
                isValid = age >= 13 && age <= 120\
                validationMessage = isValid ? "Valid age" : "Age must be between 13 and 120"\
            \} else if let ageString = value as? String, let age = Int(ageString) \{\
                isValid = age >= 13 && age <= 120\
                validationMessage = isValid ? "Valid age" : "Age must be between 13 and 120"\
            \} else \{\
                isValid = false\
                validationMessage = "Age must be a number"\
            \}\
            \
        default:\
            // Default validation (assume valid)\
            validationMessage = "No specific validation rules for this field"\
        \}\
        \
        // Track validation\
        AnalyticsManager.shared.trackEvent("field_validation", properties: [\
            "field": field,\
            "is_valid": isValid,\
            "message": validationMessage\
        ])\
        \
        return [\
            "valid": isValid,\
            "message": validationMessage\
        ]\
    \}\
\}\
\
// MARK: - Tool Error\
enum ToolError: Error \{\
    case missingParameter(String)\
    case executionFailed(String)\
    case unauthorized\
    case invalidInput(String)\
\}\
