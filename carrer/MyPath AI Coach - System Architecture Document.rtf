### 6.2 PostgreSQL Functions\
\
#### match_careers\
\
```sql\
CREATE OR REPLACE FUNCTION match_careers(\
  query_embedding vector(1536),\
  match_threshold float,\
  match_count int,\
  query text\
)\
RETURNS TABLE (\
  id uuid,\
  title text,\
  description text,\
  requirements text[],\
  salary text,\
  growth text,\
  match float\
)\
LANGUAGE plpgsql\
AS $$\
BEGIN\
  RETURN QUERY\
  SELECT\
    c.id,\
    c.title,\
    c.description,\
    c.requirements,\
    c.salary,\
    c.growth,\
    1 - (c.embedding <=> query_embedding) AS match\
  FROM careers c\
  WHERE 1 - (c.embedding <=> query_embedding) > match_threshold\
  ORDER BY match DESC\
  LIMIT match_count;\
END;\
$$;\
```\
\
#### update_user_profile\
\
```sql\
CREATE OR REPLACE FUNCTION update_user_profile(\
  user_id text,\
  field text,\
  value jsonb\
)\
RETURNS json\
LANGUAGE plpgsql\
SECURITY DEFINER\
AS $$\
DECLARE\
  result json;\
BEGIN\
  UPDATE profiles\
  SET data = jsonb_set(data, ARRAY[field], value)\
  WHERE profiles.user_id = update_user_profile.user_id;\
  \
  IF FOUND THEN\
    result := json_build_object('success', true);\
  ELSE\
    result := json_build_object('success', false);\
  END IF;\
  \
  RETURN result;\
END;\
$$;\
```\
