    private func loadModel() \{\
        do \{\
            // Try to load the model\
            guard let modelURL = Bundle.main.url(forResource: modelName, withExtension: "mlmodelc") else \{\
                print("Failed to find model URL")\
                return\
            \}\
            \
            // Configure model\
            let config = MLModelConfiguration()\
            config.computeUnits = .cpuAndGPU\
            \
            // Load model\
            model = try MLModel(contentsOf: modelURL, configuration: config)\
            print("Successfully loaded Core ML model: \\(modelName)")\
        \} catch \{\
            print("Failed to load Core ML model: \\(error)")\
        \}\
    \}\
    \
    // MARK: - Response Generation\
    func generateResponse(to message: String) async throws -> String \{\
        guard let model = model else \{\
            throw CoreMLError.modelNotLoaded\
        \}\
        \
        // Create input dictionary\
        let input: [String: Any] = [\
            "prompt": formatPrompt(message),\
            "temperature": 0.7,\
            "max_tokens": maxTokens\
        ]\
        \
        // Make prediction\
        return try await withCheckedThrowingContinuation \{ continuation in\
            do \{\
                if let prediction = try model.prediction(from: MLDictionaryFeatureProvider(dictionary: input)) as? MLDictionaryFeatureProvider,\
                   let response = prediction.dictionary["response"] as? String \{\
                    continuation.resume(returning: response)\
                \} else \{\
                    continuation.resume(throwing: CoreMLError.predictionFailed)\
                \}\
            \} catch \{\
                continuation.resume(throwing: error)\
            \}\
        \}\
    \}\
    \
    // MARK: - Helper Methods\
    private func formatPrompt(_ message: String) -> String \{\
        return """\
        <s>[INST] You are an offline assistant in the MyPath app. Provide a helpful but brief response.\
        \
        User message: \\(message) [/INST]\
        """\
    \}\
    \
    // MARK: - Errors\
    enum CoreMLError: Error \{\
        case modelNotLoaded\
        case predictionFailed\
    \}\
